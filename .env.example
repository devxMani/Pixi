# Copy to .env for local development. Never commit real values.
APP_ENV=development
APP_NAME=Pixi
DATABASE_URL=postgresql+psycopg://pixi:pixi@localhost:5432/pixi
# Provider credentials belong only in local .env or a managed secret store.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional Pixi HTTP JSON bridge. Configure only for a trusted endpoint you operate.
# The endpoint must implement docs/AGENT_BRIDGE.md; this does not auto-integrate a vendor.
# HTTPS is required except for localhost/loopback during APP_ENV=development.
# PIXI_AGENT_ENDPOINT=https://your-agent.example.com/pixi/evaluate
# PIXI_AGENT_API_KEY=
# PIXI_AGENT_TIMEOUT_SECONDS=15
